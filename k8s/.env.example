# Kubernetes Deployment Environment Variables
# Copy to k8s/.env and fill in real values before deploying.
#
# Usage:
#   source k8s/.env
#   envsubst < k8s/config/secrets.yaml | kubectl apply -f -
#   envsubst < k8s/jobs/migrate-job.yaml | kubectl apply -f -
#
# For a test cluster, also update configmap.yaml values (site URL,
# DB_HOST, REDIS_URL) to match your test environment.

# ===========================================
# Azure Infrastructure
# ===========================================
ACR_NAME=gasacr
AKS_CLUSTER_NAME=gas-aks
AKS_RESOURCE_GROUP=gas-rg

# ===========================================
# Container Images
# ===========================================
# Tag to deploy — use a git SHA or "latest" for testing.
IMAGE_TAG=latest
# Short suffix for the migration Job name (must be unique per deploy).
JOB_SUFFIX=test

# ===========================================
# Database Credentials
# ===========================================
MYSQL_ROOT_PASSWORD=
DB_USER=gas_user
DB_PASSWORD=

# ===========================================
# Application Secrets
# ===========================================
# Generate each with: openssl rand -hex 32
JWT_SECRET=
NUXT_API_SECRET=
ANALYTICS_IP_SALT=

# ===========================================
# Overrides for Test Clusters
# ===========================================
# These values are hardcoded in k8s/config/configmap.yaml for production.
# To test on a different cluster, update configmap.yaml or create a
# test-specific ConfigMap with these values.
#
# NUXT_PUBLIC_SITE_URL=https://staging.audit.gov.gh
# DB_HOST=mysql.gas.svc.cluster.local
# DB_PORT=3306
# DB_NAME=ghana_audit_service
# REDIS_URL=redis://redis.gas.svc.cluster.local:6379/0
