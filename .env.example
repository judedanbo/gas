# Docker Compose Environment Configuration
# Copy this file to .env in the same directory as docker-compose.yml

# ===========================================
# MySQL Database
# ===========================================
MYSQL_ROOT_PASSWORD=
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ghana_audit_service
DB_USER=gas_user
DB_PASSWORD=

# Initial admin user (for seeding)
ADMIN_EMAIL=admin@audit.gov.gh
ADMIN_PASSWORD=

# ===========================================
# Application Settings
# ===========================================
NUXT_PUBLIC_SITE_URL=https://audit.gov.gh
NUXT_PUBLIC_SITE_NAME=Ghana Audit Service
NUXT_PUBLIC_CONTACT_EMAIL=info@audit.gov.gh
NUXT_PUBLIC_CONTACT_PHONE=+233 (302) 664929

# ===========================================
# Security
# ===========================================
NUXT_API_SECRET=generate-a-secure-api-secret-here
JWT_SECRET=generate-a-secure-jwt-secret-here

# Admin session expiry (durations accept ms/s/m/h/d, e.g. 30m, 8h).
# Idle = sliding inactivity window; Absolute = hard cap from login;
# Warning = lead time before idle expiry for the countdown modal.
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h
SESSION_WARNING_BEFORE=2m

# ===========================================
# Redis (rate limiter + analytics hot counters)
# ===========================================
# Inside docker-compose, the frontend reaches Redis at the service hostname.
REDIS_URL=redis://redis:6379/0

# ===========================================
# Azure Blob Storage (report / publication PDFs)
# ===========================================
# Store report PDFs in a private Blob container instead of on disk. Leave BOTH
# unset to keep PDFs in public/pdf (default; fine for local Docker dev). When
# both are set, uploads write to Blob and /api/downloads/** streams from Blob.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_BLOB_CONTAINER=reports

# ===========================================
# Analytics
# ===========================================
# 32+ byte secret used to salt sha256(ip). Rotate quarterly; rotation
# anonymises older hashed IPs.
ANALYTICS_IP_SALT=generate-a-32-byte-analytics-salt
# Retention for raw request_events (days). Aggregates and download_events
# have separate, longer retention managed in code.
ANALYTICS_RETENTION_DAYS=30
# MaxMind GeoLite2 databases (optional). Files are NOT committed; download
# them free from https://www.maxmind.com/, place under ./data/, and bind
# them into the frontend container at /app/data via docker-compose. Leave
# unset to disable enrichment.
# ANALYTICS_GEOIP_DB_PATH=/app/data/GeoLite2-Country.mmdb
# ANALYTICS_ASN_DB_PATH=/app/data/GeoLite2-ASN.mmdb

# ===========================================
# Sentry Error Tracking (optional)
# ===========================================
NUXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
