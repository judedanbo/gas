# Ghana Audit Service - Environment Configuration
# Copy this file to .env and update the values

# ===========================================
# Application Settings
# ===========================================
NUXT_PUBLIC_SITE_URL=https://audit.gov.gh
NUXT_PUBLIC_SITE_NAME="Audit Service"

# ===========================================
# Contact Information
# ===========================================
NUXT_PUBLIC_CONTACT_EMAIL=info@audit.gov.gh
NUXT_PUBLIC_CONTACT_PHONE="+233 (302) 664929"

# ===========================================
# API Configuration (if using external API)
# ===========================================
NUXT_API_SECRET=your-api-secret-here
NUXT_API_BASE_URL=https://api.audit.gov.gh

# ===========================================
# Analytics & Tracking (optional)
# ===========================================
# NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# NUXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ===========================================
# Email / SMTP (required for contact form notifications)
# ===========================================
NUXT_SMTP_HOST=smtp.example.com
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=your-smtp-user
NUXT_SMTP_PASS=your-smtp-password
NUXT_SMTP_FROM=noreply@audit.gov.gh

# ===========================================
# Database Configuration (MySQL/MariaDB)
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=gas_user
DB_PASSWORD=your-secure-password
DB_NAME=ghana_audit_service

# ===========================================
# Admin Authentication (JWT)
# ===========================================
JWT_SECRET=generate-a-32-character-secret-key
JWT_EXPIRES_IN=7d

# Initial admin user (for seeding)
ADMIN_EMAIL=admin@audit.gov.gh
ADMIN_PASSWORD=change-this-password

# ===========================================
# Security
# ===========================================
# NUXT_SESSION_SECRET=generate-a-long-random-string

# ===========================================
# Redis (rate limiter + analytics hot counters)
# ===========================================
# Leave unset to fall back to the in-memory rate limiter (single-instance only).
# When set, the Nitro server uses Redis for shared rate-limit state and
# (in later phases) analytics hot counters.
REDIS_URL=redis://localhost:6379/0

# ===========================================
# Analytics
# ===========================================
# 32+ byte secret used to salt sha256(ip). Rotate quarterly to anonymise
# older hashed IPs.
ANALYTICS_IP_SALT=generate-a-32-byte-analytics-salt
# Retention for raw request_events (days). Aggregates and download_events
# have separate, longer retention managed in code.
ANALYTICS_RETENTION_DAYS=30
# MaxMind GeoLite2 databases for country + ASN enrichment. Files are NOT
# committed (license forbids redistribution). Sign up free at
# https://www.maxmind.com/, download GeoLite2-Country.mmdb and
# GeoLite2-ASN.mmdb, and point these vars at the local paths. Leave unset
# to disable enrichment — country/asn columns just stay null.
# ANALYTICS_GEOIP_DB_PATH=./data/GeoLite2-Country.mmdb
# ANALYTICS_ASN_DB_PATH=./data/GeoLite2-ASN.mmdb

# ===========================================
# Feature Flags
# ===========================================
# NUXT_PUBLIC_ENABLE_NEWSLETTER=true
# NUXT_PUBLIC_ENABLE_SEARCH=true
# NUXT_PUBLIC_ENABLE_CHAT=false

