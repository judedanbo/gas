# Ghana Audit Service - Environment Configuration
# Copy this file to .env and update the values.
#
# SECURITY: all secret values below are INSECURE PLACEHOLDERS — replace before
# any non-local use. Generate strong secrets with `openssl rand -hex 32`.
# Placeholder/short secrets are flagged at startup in production
# (server/plugins/validateConfig.ts). Use a strong, unique ADMIN_PASSWORD (the
# seed runs manually, never on deploy) and change it after first login.

# ===========================================
# Application Settings
# ===========================================
NUXT_PUBLIC_SITE_URL=https://audit.gov.gh
NUXT_PUBLIC_SITE_NAME="Audit Service"

# Optional: extra hosts the publication download endpoint may 302-redirect to
# (comma-separated). The site host (NUXT_PUBLIC_SITE_URL) and audit.gov.gh are
# always allowed; any other absolute fileUrl returns 404. See SECURITY-ASSESSMENT.md (M-4).
# DOWNLOAD_REDIRECT_ALLOWED_HOSTS=files.example.gov.gh,cdn.example.org

# ===========================================
# Contact Information
# ===========================================
NUXT_PUBLIC_CONTACT_EMAIL=info@audit.gov.gh
NUXT_PUBLIC_CONTACT_PHONE="+233 (302) 664929"

# ===========================================
# API Configuration (if using external API)
# ===========================================
NUXT_API_SECRET=your-api-secret-here
NUXT_API_BASE_URL=https://api.audit.gov.gh

# ===========================================
# Analytics & Tracking (optional)
# ===========================================
# NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# NUXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ===========================================
# Email / SMTP (invitation + contact-form notifications)
# ===========================================
# All four of HOST/USER/PASS/FROM must be set or email is skipped. FROM must be
# an address the SMTP account is authorized to send as (for M365 this is usually
# the auth mailbox itself), or the provider rejects with 554 SendAsDenied.
NUXT_SMTP_HOST=smtp.example.com
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=your-smtp-user
NUXT_SMTP_PASS=your-smtp-password
NUXT_SMTP_FROM=your-smtp-user@example.com

# ===========================================
# Database Configuration (MySQL/MariaDB)
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=gas_user
DB_PASSWORD=your-secure-password
DB_NAME=ghana_audit_service

# ===========================================
# Admin Authentication (JWT + server-side sessions)
# ===========================================
JWT_SECRET=generate-a-32-character-secret-key
# JWT_EXPIRES_IN is now derived from SESSION_ABSOLUTE_TIMEOUT (the token and
# the server-side session expire together). Only used as a fallback.
JWT_EXPIRES_IN=7d

# Admin session expiry. Durations accept ms/s/m/h/d suffixes (e.g. 30m, 8h).
# SESSION_IDLE_TIMEOUT     — sliding inactivity window (default 30m)
# SESSION_ABSOLUTE_TIMEOUT — hard cap from login regardless of activity (default 8h)
# SESSION_WARNING_BEFORE   — lead time before idle expiry to show the
#                            countdown modal; clamped below the idle window (default 2m)
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h
SESSION_WARNING_BEFORE=2m

# Per-account login lockout (defends against distributed brute force; separate
# from the per-IP rate limit). Defaults shown. Lockout duration uses exponential
# backoff per consecutive lockout: min(base * multiplier^(n-1), max).
# Set LOGIN_LOCKOUT_BACKOFF_MULTIPLIER=1 for a constant lockout duration.
# LOGIN_LOCKOUT_MAX_FAILURES=10
# LOGIN_LOCKOUT_WINDOW=15m
# LOGIN_LOCKOUT_BASE_DURATION=15m
# LOGIN_LOCKOUT_BACKOFF_MULTIPLIER=2
# LOGIN_LOCKOUT_MAX_DURATION=24h

# Initial admin user (for seeding)
ADMIN_EMAIL=admin@audit.gov.gh
ADMIN_PASSWORD=change-this-password

# ===========================================
# Security
# ===========================================
# NUXT_SESSION_SECRET=generate-a-long-random-string

# ===========================================
# Redis (rate limiter + analytics hot counters)
# ===========================================
# Leave unset to fall back to the in-memory rate limiter (single-instance only).
# When set, the Nitro server uses Redis for shared rate-limit state and
# analytics hot counters. REQUIRED in production multi-instance deployments —
# without it rate limits are per-process and not shared across replicas (the
# server logs a startup warning in production when unset).
REDIS_URL=redis://localhost:6379/0
# TLS (k8s only): use a rediss:// REDIS_URL and point REDIS_CA_FILE at the CA
# that signs the Redis server cert to verify it. Local dev stays plain redis://
# (leave REDIS_CA_FILE unset). Set REDIS_TLS_REJECT_UNAUTHORIZED=false to keep
# encryption but skip server-identity verification (stopgap for cert issues).
# REDIS_CA_FILE=/tls/redis-ca.crt
# REDIS_TLS_REJECT_UNAUTHORIZED=true

# ===========================================
# Azure Blob Storage (report / publication PDFs)
# ===========================================
# Report PDFs are stored in a private Blob container instead of shipping inside
# the container image. Leave BOTH unset to fall back to on-disk public/pdf
# (legacy / local dev). When both are set, uploads write to Blob and the
# /api/downloads/** endpoints stream from Blob (falling back to disk per file).
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_BLOB_CONTAINER=reports

# ===========================================
# Analytics
# ===========================================
# 32+ byte secret used to salt sha256(ip). Rotate quarterly to anonymise
# older hashed IPs.
ANALYTICS_IP_SALT=generate-a-32-byte-analytics-salt
# Retention for raw request_events (days), which now include the raw client IP
# (de-hashed for abuse attribution + geolocation). Aggregates and download_events
# have separate, longer retention managed in code.
ANALYTICS_RETENTION_DAYS=90
# MaxMind GeoLite2 databases for country + ASN enrichment. Files are NOT
# committed (license forbids redistribution). Sign up free at
# https://www.maxmind.com/, download GeoLite2-Country.mmdb and
# GeoLite2-ASN.mmdb, and point these vars at the local paths. Leave unset
# to disable enrichment — country/asn columns just stay null.
# ANALYTICS_GEOIP_DB_PATH=./data/GeoLite2-Country.mmdb
# ANALYTICS_ASN_DB_PATH=./data/GeoLite2-ASN.mmdb

# ===========================================
# Feature Flags
# ===========================================
# NUXT_PUBLIC_ENABLE_NEWSLETTER=true
# NUXT_PUBLIC_ENABLE_SEARCH=true
# NUXT_PUBLIC_ENABLE_CHAT=false

GEMINI_API_KEY=your-key-here 
# ===========================================
# YouTube Live Events (optional)
# ===========================================
# YouTube Data API v3 key used by /api/live-events to confirm and enrich
# live-broadcast detection. Leave unset to rely solely on the keyless
# channel /live probe. Calls are cached server-side, so the default
# 10k units/day quota is plenty (search.list costs 100 units per call).
# YOUTUBE_API_KEY=
